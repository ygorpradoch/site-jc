# Pasta de envios: só imagens e vídeo MP4; nenhum script é executado aqui
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar

<IfModule mod_authz_core.c>
<FilesMatch ".*">
Require all denied
</FilesMatch>
<FilesMatch "\.(webp|jpe?g|png|mp4)$">
Require all granted
</FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
<FilesMatch ".*">
Order deny,allow
Deny from all
</FilesMatch>
<FilesMatch "\.(webp|jpe?g|png|mp4)$">
Order allow,deny
Allow from all
</FilesMatch>
</IfModule>

<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Content-Disposition "inline"
</IfModule>
